# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo

# Node
node_modules/
dist/
.npm/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Go
vendor/

# Build artifacts
build/
out/
target/

# Secrets (CRITICAL)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
# Real secret manifests + recovered credentials — NEVER commit.
# Only the *.example templates are tracked.
secrets.yaml
*.secret.yaml
*-secrets.yaml
*.recovered.yaml
recovered-secrets/
.secrets-recovery/
# k3s cluster token — real one is gitignored; only .token.example is tracked.
k3s/.token
**/k3s/.token

# Logs
*.log
!.claude/audit.log

# Claude local-only state
.claude/settings.local.json
.claude/.cache/
# Per-session archives: keep the dir (.gitkeep is tracked), never commit the reports
# themselves (local git-state snapshots + session-end logs — noise, not source of truth).
.claude/session-reports/*
!.claude/session-reports/.gitkeep
# Editor/tool backups + init locks under .claude (settings*.bak, .cozempic-init.lock, etc.)
.claude/*.bak
.claude/**/*.bak-*
.claude/.cozempic-init.lock

# MACF hand-wire local state (substrate channel-server config — DR-005 Decision 6).
# Per-machine + sensitive (certs incl. keys, App creds, channel logs); never committed.
# The CONTENT/recipe is documented in design/DR-005...; the files are per-home local state.
.macf/
.claude/.macf/

# DR-040 Decision 4 maintenance-lock (fleet/maintenance-lock.sh, #158) — ephemeral
# per-upgrade runtime state, never git-persisted (on K8s it's a pod annotation, no
# file at all). The default path is $HOME/.macf/maintenance-locks/ (already outside
# any repo checkout, same as PAUSED_DIR/LAST_EXIT_DIR/STATE_DIR/ALERT_DIR); these
# patterns are defense-in-depth in case MACF_MAINT_LOCK_DIR is ever pointed at an
# in-repo path (e.g. local dev/testing convenience).
fleet/locks/
.macf/maintenance-locks/
.claude/.macf/maintenance.lock

# --- macf-managed files (groundnuty/macf#1412/#1416) ---
# These are byte-copies written by `macf rules refresh`. Tracking them makes git
# a SECOND WRITER: a checkout/reset/fresh-clone silently reinstalls the committed
# copy over a current one, and the workspace reads as healthy while being stale.
#
# Scripts are ignored wholesale — every one is tool-managed.
.claude/scripts/

# Rules are ignored BY NAME, not by directory. `.claude/rules/` is NOT homogeneous:
# it holds canonical copies AND this workspace's own hand-authored rules, which are
# the substrate's actual output. A blanket ignore would make those untrackable —
# not drift, simply ABSENT on a fresh clone (macf-science-agent's objection on #1416).
# Managed (ignored):
.claude/rules/assert-the-wrong-path.md
.claude/rules/check-before-propose.md
.claude/rules/codify-at-correction-time.md
.claude/rules/coordination.md
.claude/rules/delegation-template.md
.claude/rules/execute-on-directive.md
.claude/rules/gh-token-attribution-traps.md
.claude/rules/mention-routing-hygiene.md
.claude/rules/model-era-compatibility.md
.claude/rules/observability-wiring.md
.claude/rules/peer-dynamic.md
.claude/rules/pr-discipline.md
.claude/rules/reflection-staging.md
.claude/rules/silent-fallback-hazards.md
.claude/rules/test-timeout-discriminator.md
.claude/rules/verify-before-claim.md

# Hand-authored and DELIBERATELY still tracked: agent-identity.md, autonomous-work.md, gh-token-refresh.md, project-conventions.md
