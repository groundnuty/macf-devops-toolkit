# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo

# Node
node_modules/
dist/
.npm/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Go
vendor/

# Build artifacts
build/
out/
target/

# Secrets (CRITICAL)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
# Real secret manifests + recovered credentials — NEVER commit.
# Only the *.example templates are tracked.
secrets.yaml
*.secret.yaml
*-secrets.yaml
*.recovered.yaml
recovered-secrets/
.secrets-recovery/
# k3s cluster token — real one is gitignored; only .token.example is tracked.
k3s/.token
**/k3s/.token

# Logs
*.log
!.claude/audit.log

# Claude local-only state
.claude/settings.local.json
.claude/.cache/

# MACF hand-wire local state (substrate channel-server config — DR-005 Decision 6).
# Certs (keys), the cert-management macf-agent.json marker, and channel logs are
# per-machine + sensitive; never committed.
.macf/
