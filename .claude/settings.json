{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "alwaysThinkingEnabled": true,
  "verbose": true,
  "effortLevel": "xhigh",
  "enableAllProjectMcpServers": false,
  "env": {
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "ENABLE_LSP_TOOL": "1"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Skill(macf-agent:macf-status)",
      "Skill(macf-agent:macf-issues)",
      "Skill(macf-agent:macf-peers)",
      "Skill(macf-agent:macf-ping)",
      "Skill(macf-agent:macf-notify-peer)",
      "mcp__macf-agent__notify_peer",
      "mcp__macf-agent__checkpoint_to_memory",
      "Bash",
      "mcp__claude_ai_Gmail__*",
      "mcp__claude_ai_Slack__*",
      "mcp__claude_ai_PubMed__*",
      "mcp__claude_ai_Scholar_Gateway__*",
      "mcp__claude_ai_alphaXiv__*",
      "mcp__claude_ai_bioRxiv__*",
      "mcp__claude_ai_PDF_Viewer__*"
    ],
    "deny": [
      "Read(~/.ssh/id_*)",
      "Read(~/.ssh/*.pem)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.netrc)",
      "Read(~/.config/gh/**)",
      "Read(~/.bash_history)",
      "Read(~/.zsh_history)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude.json)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.kube/**)",
      "Edit(~/.config/gcloud/**)",
      "Edit(~/.gitconfig)",
      "Edit(~/.npmrc)",
      "Edit(~/.pypirc)",
      "Edit(~/.docker/config.json)",
      "Edit(~/.netrc)",
      "Edit(~/.config/gh/**)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.profile)",
      "Edit(~/.bash_profile)",
      "Edit(~/.zprofile)",
      "Edit(~/.zshenv)",
      "Bash(sudo *)",
      "Bash(rm -rf /)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(docker push *)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.docker/config.json)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "failIfUnavailable": true,
    "excludedCommands": [
      "ssh:*",
      "scp:*",
      "rsync:*",
      "devbox:*",
      "nix:*",
      "git:*",
      "gpg:*",
      "gpg-agent:*",
      "helm:*",
      "kubectl:*",
      "kustomize:*",
      "terraform:*",
      "docker:*",
      "podman:*",
      "aws:*",
      "gcloud:*",
      "az:*",
      "gh:*",
      "npx:*",
      "npm:*",
      "node:*",
      "make:*",
      "tmux:*",
      "jq:*",
      "openssl:*",
      "grep:*",
      "rg:*",
      "find:*",
      "head:*",
      "tail:*",
      "cat:*",
      "ls:*",
      "wc:*",
      "sort:*",
      "awk:*",
      "sed:*",
      "diff:*",
      "which:*",
      "bash:*",
      "sh:*",
      "xargs:*",
      "mkdir:*",
      "cp:*",
      "touch:*"
    ],
    "network": {
      "allowedDomains": [
        "*"
      ],
      "deniedDomains": []
    },
    "filesystem": {
      "allowWrite": [
        "~/.claude/projects",
        "~/.cache/devbox",
        "~/.local/share/devbox",
        "~/.nix-profile",
        "/nix"
      ],
      "denyWrite": [
        "/etc",
        "/usr",
        "/bin",
        "/sbin",
        "~/.ssh",
        "~/.aws",
        "~/.bashrc",
        "~/.zshrc"
      ],
      "denyRead": [
        "~/.aws",
        "~/.kube",
        "~/.config/gcloud",
        "~/.ssh/id_*",
        "~/.ssh/*.pem"
      ],
      "allowRead": [
        "/proc/self/fd"
      ]
    }
  },
  "marketplaces": {
    "claude-plugins-official": {
      "source": "github",
      "repo": "anthropics/claude-plugins-official"
    },
    "superpowers-marketplace": {
      "source": "github",
      "repo": "obra/superpowers-marketplace"
    }
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "session-report@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "elements-of-style@superpowers-marketplace": true,
    "context7@external-plugins": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/check-gh-token.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/check-mention-routing.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/check-lgtm-gate.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/check-close-keyword.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/check-auditor-never-acts.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/check-gh-attribution.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Branch: $(git branch --show-current 2>/dev/null || echo detached). Recent: $(git log --oneline -3 2>/dev/null || echo no-commits)\"",
            "timeout": 5000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/check-channels-enabled.sh"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/macf-startup-pickup.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s\\t%s\\t%s\\n' \"$(date -u +%FT%TZ)\" \"$(git config user.email 2>/dev/null || echo -)\" \"${CLAUDE_HOOK_FILE:-?}\" >> \"$CLAUDE_PROJECT_DIR/.claude/audit.log\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'mkdir -p \"$CLAUDE_PROJECT_DIR/.claude/session-reports\"; TS=$(date -u +%Y%m%dT%H%M%SZ); [ -n \"$CLAUDE_TRANSCRIPT_PATH\" ] && cp \"$CLAUDE_TRANSCRIPT_PATH\" \"$CLAUDE_PROJECT_DIR/.claude/session-reports/${TS}-precompact-transcript.jsonl\" 2>/dev/null; { echo \"# Pre-compact $TS\"; git -C \"$CLAUDE_PROJECT_DIR\" status -sb; echo; git -C \"$CLAUDE_PROJECT_DIR\" log --oneline -10; } > \"$CLAUDE_PROJECT_DIR/.claude/session-reports/${TS}-precompact-gitstate.md\"; echo \"[PreCompact] Context compaction imminent. Transcript archived at .claude/session-reports/${TS}-precompact-transcript.jsonl - run /session-report for a narrative summary before history is compressed.\" >&2'",
            "timeout": 30000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:macf-channel-server:macf-agent",
            "tool": "checkpoint_to_memory",
            "input": {
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}"
            },
            "timeout": 30,
            "statusMessage": "Writing session checkpoint to memory... (macf#731 stopgap)"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'mkdir -p \"$CLAUDE_PROJECT_DIR/.claude/session-reports\"; TS=$(date -u +%Y%m%dT%H%M%SZ); { echo \"# Session end $TS\"; git -C \"$CLAUDE_PROJECT_DIR\" status -sb; echo; git -C \"$CLAUDE_PROJECT_DIR\" log --oneline -10; } > \"$CLAUDE_PROJECT_DIR/.claude/session-reports/${TS}-session-end.md\"'",
            "timeout": 10000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/emit-turn-receipt.sh",
            "async": true
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "macf-agent"
  ]
}
